{
  "name": "enum",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/enum/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/enum",
        "main": "libs/enum/src/index.ts",
        "tsConfig": "libs/enum/tsconfig.lib.json",
        "assets": ["libs/enum/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/enum/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node --test --test-reporter=spec -r ts-node/register -r tsconfig-paths/register libs/enum/src/*.test.ts",
        "env": {
          "TS_NODE_PROJECT": "libs/enum/tsconfig.spec.json"
        }
      }
    }
  }
}
