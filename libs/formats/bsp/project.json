{
  "name": "formats-bsp",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/formats/bsp/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/formats/bsp",
        "main": "libs/formats/bsp/src/index.ts",
        "tsConfig": "libs/formats/bsp/tsconfig.lib.json",
        "assets": ["libs/formats/bsp/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/formats/bsp/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node --test --test-reporter=spec -r ts-node/register -r tsconfig-paths/register libs/formats/bsp/src/*.test.ts",
        "env": {
          "TS_NODE_PROJECT": "libs/formats/bsp/tsconfig.spec.json"
        }
      }
    }
  }
}
