{
  "name": "formats-replay",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/formats/replay/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/replay/formats/replay",
        "main": "libs/formats/bsp/src/index.ts",
        "tsConfig": "libs/formats/replay/tsconfig.lib.json",
        "assets": ["libs/formats/replay/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/formats/replay/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node --test -r ts-node/register -r tsconfig-paths/register libs/formats/replay/src/*.spec.ts",
        "env": {
          "TS_NODE_PROJECT": "libs/formats/replay/tsconfig.spec.json"
        }
      }
    }
  }
}
