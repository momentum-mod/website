{
  "name": "formats-zone",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/formats/zone/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/formats/zone",
        "main": "libs/formats/zone/src/index.ts",
        "tsConfig": "libs/formats/zone/tsconfig.lib.json",
        "assets": ["libs/formats/zone/*.md"]
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "command": "eslint",
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node --test --test-reporter=spec -r ts-node/register -r tsconfig-paths/register libs/formats/zone/src/*.test.ts",
        "env": {
          "TS_NODE_PROJECT": "libs/formats/zone/tsconfig.spec.json"
        }
      }
    }
  }
}
