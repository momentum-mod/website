{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "momentum",
  "sourceRoot": "apps/frontend/src",
  "tags": ["frontend"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/frontend",
          "browser": ""
        },
        "index": "apps/frontend/src/index.html",
        "tsConfig": "apps/frontend/tsconfig.app.json",
        "assets": ["apps/frontend/src/favicon.ico", "apps/frontend/src/assets"],
        "styles": ["apps/frontend/src/app/theme/styles.css"],
        "aot": true,
        "browser": "apps/frontend/src/main.ts"
      },
      "configurations": {
        "production": {
          "namedChunks": false,
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/app/env/environment.ts",
              "with": "apps/frontend/src/app/env/environment.prod.ts"
            }
          ],
          "plugins": ["apps/frontend/sitemap-redirect-generator.ts"],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.25mb",
              "maximumError": "1.5mb"
            },
            {
              "type": "all",
              "maximumError": "2.5mb"
            }
          ],
          "outputHashing": "all",
          "statsJson": true
        },
        "staging": {
          "namedChunks": false,
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/app/env/environment.ts",
              "with": "apps/frontend/src/app/env/environment.staging.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.25mb",
              "maximumError": "1.5mb"
            },
            {
              "type": "all",
              "maximumError": "2.5mb"
            }
          ],
          "outputHashing": "all",
          "statsJson": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "outputHashing": "media"
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "options": {
        "proxyConfig": "apps/frontend/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "frontend:build:production"
        },
        "development": {
          "buildTarget": "frontend:build:development"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "command": "eslint",
        "args": ["**/*.ts", "**/*.html"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node --test --test-reporter=spec -r ts-node/register -r tsconfig-paths/register -r ./apps/frontend/src/test-setup.ts \"apps/frontend/src/**/*.test.ts\"",
        "env": {
          "TS_NODE_PROJECT": "apps/frontend/tsconfig.spec.json",
          "TS_NODE_TRANSPILE_ONLY": "true"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "frontend:build"
      }
    }
  }
}
