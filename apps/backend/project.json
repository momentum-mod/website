{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["backend"],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/backend"],
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "backend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "command": "eslint",
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register -r reflect-metadata -r ./apps/backend/test/test-setup.ts --test --test-reporter=spec \"apps/backend/src/**/*.test.ts\"",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.spec.json",
          "TS_NODE_TRANSPILE_ONLY": "true"
        }
      }
    }
  }
}
