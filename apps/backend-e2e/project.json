{
  "name": "backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend-e2e/src",
  "projectType": "application",
  "implicitDependencies": ["backend"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register apps/backend-e2e/run-tests.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/backend-e2e/tsconfig.spec.json",
          "TS_NODE_TRANSPILE_ONLY": "true"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/backend-e2e/**/*.{js,ts}"]
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register apps/backend-e2e/run-tests.ts --watch",
        "env": {
          "TS_NODE_PROJECT": "apps/backend-e2e/tsconfig.spec.json",
          "TS_NODE_TRANSPILE_ONLY": "true"
        }
      }
    }
  }
}
